{
  "name": "qr_code_generator",
  "displayName": "QR Code Generator",
  "version": "0.0.1",
  "description": "Convert any link or text into a QR code.",
  "author": "Tarikul Islam",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "motion": "^12.26.2",
    "plasmo": "0.90.5",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": ["https://*/*"]
  },
  "ico": "assets/icon.ico",
  "plasmo": {
    "icons": {
      "16": "assets/icon-16.ico",
      "32": "assets/icon-32.ico",
      "48": "assets/icon-48.ico",
      "64": "assets/icon-64.ico",
      "128": "assets/icon-128.ico"
    }
  }
}